# ── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_chave_anon_publica
SUPABASE_SECRET_KEY=sua_chave_secreta_do_servidor

# ── Cron ─────────────────────────────────────────────────────────────────────
CRON_SECRET=segredo_para_proteger_as_rotas_de_cron

# ── IA e scraping ────────────────────────────────────────────────────────────
# ATENÇÃO: estas chaves são lidas SOMENTE no servidor. O painel não as recebe
# nem as guarda — a tela "Configurações IA" apenas informa se estão definidas.
# Se faltarem, o gerador de posts por IA fica indisponível (o resto do site
# continua funcionando normalmente).
GEMINI_API_KEY=sua_chave_do_gemini
APIFY_API_TOKEN=seu_token_do_apify

# ── Cloudflare R2 (capas dos posts) ──────────────────────────────────────────
R2_ACCOUNT_ID=seu_account_id
R2_ACCESS_KEY_ID=sua_access_key
R2_SECRET_ACCESS_KEY=sua_secret_key
R2_BUCKET_NAME=nome_do_bucket
# Opcionais: derivados de R2_ACCOUNT_ID/R2_BUCKET_NAME quando ausentes.
R2_ENDPOINT=
R2_PUBLIC_DOMAIN=
